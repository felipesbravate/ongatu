# Copy to .env.local (git-ignored) for local runs; set the same names in your host's secret store for production.
# NEVER commit real values.

# Public origin of the deployed app, no trailing slash. Used for CSRF checks and sign-in links.
APP_ORIGIN=https://costs.example.com

# Supabase project (Settings -> API). The service-role key bypasses every restriction: server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption master keys. Generate with: npm run gen-key
MASTER_KEYS=
MASTER_KEY_ACTIVE=v1

# Document reading (Anthropic API). Check the current model list and pick a vision-capable model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated emails that are always approved and can approve others.
ADMIN_EMAILS=you@example.com

# Max document reads per user per day (cost control).
DAILY_READ_CAP=30

# Shared boards (optional): "notify by email" for invite links through Resend. Without these the app copies/shares
# the link instead. MAIL_FROM must be a sender on a domain verified in Resend, e.g. Ongatu <invites@example.com>
RESEND_API_KEY=
MAIL_FROM=
